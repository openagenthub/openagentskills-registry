{
  "name": "openagentskills-registry",
  "version": "1.0.0",
  "description": "Community-driven registry for AI agent skills",
  "type": "module",
  "scripts": {
    "validate:changed": "tsx scripts/validate-changed.ts",
    "sync-registry": "tsx scripts/sync-registry.ts",
    "call-worker": "tsx scripts/call-worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agent-skills",
    "ai",
    "claude",
    "registry"
  ],
  "author": "Open Agent Hub",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.39.3",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^4.0.18",
    "ajv": "^8.12.0",
    "eslint": "^9.0.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18",
    "yaml": "^2.3.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
