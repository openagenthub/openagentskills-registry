{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openagentskills.org/schemas/skill.schema.json",
  "title": "Open Agent Skill",
  "description": "Schema for skill.yaml files in the Open Agent Skills registry. These files are static, contributor-owned pointers. Dynamic metadata (name, description, timestamps, status) is stored in Cloudflare KV, not in the YAML.",
  "type": "object",
  "required": ["source", "categories", "tags"],
  "properties": {
    "source": {
      "type": "object",
      "description": "Defines where the skill content (SKILL.md) is located",
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "external",
              "description": "Skill content lives in an external GitHub repository"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://github\\.com/[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+$",
              "description": "GitHub repository URL (e.g. https://github.com/anthropics/skills)"
            },
            "path": {
              "type": "string",
              "description": "Path within the source repo to the SKILL.md directory",
              "pattern": "^[a-zA-Z0-9._/-]+$"
            },
            "ref": {
              "type": "string",
              "default": "main",
              "description": "Git reference (branch, tag, or commit SHA)"
            }
          },
          "required": ["type", "url", "path"]
        },
        {
          "properties": {
            "type": {
              "const": "internal",
              "description": "Skill content lives in openagentskills/{skill-name}/SKILL.md in this registry"
            }
          },
          "required": ["type"]
        }
      ]
    },
    "categories": {
      "type": "array",
      "description": "Categories this skill belongs to (1-3). Must match IDs in categories.yaml.",
      "items": {
        "type": "string",
        "enum": [
          "development",
          "databases",
          "cloud-services",
          "productivity",
          "marketing",
          "creativity",
          "data-analytics",
          "integrations",
          "communication",
          "documents"
        ]
      },
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "description": "Searchable tags for the skill (1-5)",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$",
        "maxLength": 30,
        "description": "Lowercase alphanumeric with hyphens, starting with a letter"
      },
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
