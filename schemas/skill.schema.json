{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openagentskills.org/schemas/skill.schema.json",
  "title": "Open Agent Skill",
  "description": "Schema for skill.yaml files in the Open Agent Skills registry",
  "type": "object",
  "required": ["source", "categories", "tags"],
  "properties": {
    "source": {
      "type": "object",
      "description": "Defines where the skill content is located",
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type": { 
              "const": "external",
              "description": "Skill content is in an external GitHub repository"
            },
            "path": { 
              "type": "string",
              "description": "Path within the source repo to the SKILL.md directory",
              "pattern": "^[a-zA-Z0-9._/-]+$"
            },
            "ref": { 
              "type": "string", 
              "default": "main",
              "description": "Git reference (branch, tag, or commit)"
            }
          },
          "required": ["type", "path"]
        },
        {
          "properties": {
            "type": { 
              "const": "local",
              "description": "Skill content is in the openagentskills/ directory of this registry"
            }
          },
          "required": ["type"]
        }
      ]
    },
    "categories": {
      "type": "array",
      "description": "Categories this skill belongs to (1-3)",
      "items": {
        "type": "string",
        "enum": [
          "document-processing",
          "creative-design",
          "development-tools",
          "data-analysis",
          "integrations",
          "productivity",
          "communication",
          "database",
          "deployment",
          "testing"
        ]
      },
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "description": "Searchable tags for the skill (1-5)",
      "items": { 
        "type": "string", 
        "pattern": "^[a-z][a-z0-9-]*$",
        "maxLength": 30,
        "description": "Lowercase alphanumeric with hyphens"
      },
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true
    },
    "_meta": {
      "type": "object",
      "description": "Auto-populated metadata by Cloudflare Worker - DO NOT EDIT MANUALLY",
      "properties": {
        "name": {
          "type": "string",
          "description": "Skill name from SKILL.md frontmatter"
        },
        "description": {
          "type": "string",
          "description": "Skill description from SKILL.md frontmatter"
        },
        "license": {
          "type": ["string", "null"],
          "description": "License from SKILL.md frontmatter"
        },
        "compatibility": {
          "type": ["string", "null"],
          "description": "Compatibility requirements from SKILL.md frontmatter"
        },
        "repoUrl": {
          "type": "string",
          "format": "uri",
          "description": "GitHub repository URL"
        },
        "lastCommit": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Last commit date for external skills"
        },
        "lastValidated": {
          "type": "string",
          "format": "date-time",
          "description": "When the skill was last validated"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "SHA256 hash of skill content for change detection"
        },
        "status": {
          "type": "string",
          "enum": ["active", "deprecated", "broken"],
          "description": "Current status of the skill"
        }
      }
    }
  },
  "additionalProperties": false
}
